# ---- TaskFlow environment ----
PORT=5000
NODE_ENV=development

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# ...or MongoDB Atlas
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# Leave MONGO_URI empty and set this to true to run a zero-setup in-memory MongoDB
USE_MEMORY_DB=false

# Insert a demo account (demo@taskflow.app / demo1234) on first boot
SEED_DEMO=false

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
